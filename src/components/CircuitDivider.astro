---
/**
 * Section divider built from the brand's circuit line (components graphics):
 * 3.5 px line, a 22 px chamfer and elliptical junction nodes. Decorative.
 */
interface Props {
  /** Mirrors the step so consecutive dividers do not look identical. */
  flip?: boolean;
  class?: string;
}

const { flip = false, class: className } = Astro.props;
---

<div class:list={['divider', className]} aria-hidden="true">
  <svg
    viewBox="0 0 1200 64"
    preserveAspectRatio="xMidYMid slice"
    class:list={{ flip }}
    fill="none"
  >
    <path
      d="M0 12 H380 L402 52 H760 L782 12 H1200"
      stroke="currentColor"
      stroke-width="3.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      vector-effect="non-scaling-stroke"
    ></path>
    <ellipse cx="402" cy="52" rx="4.5" ry="6" fill="currentColor"></ellipse>
    <ellipse cx="782" cy="12" rx="4.5" ry="6" fill="currentColor"></ellipse>
  </svg>
</div>

<style>
  .divider {
    height: 48px;
    overflow: hidden;
    color: var(--cyan);
    opacity: 0.16;
  }

  svg {
    width: 100%;
    height: 100%;
  }

  svg.flip {
    transform: scaleX(-1);
  }
</style>
