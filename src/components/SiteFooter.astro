---
import Wordmark from './Wordmark.astro';
import { siteConfig } from '../config/site';
import { productList } from '../data/products';
import { pick, type Dictionary, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  t: Dictionary['footer'];
  homeLabel: string;
  externalHint: string;
}

const { locale, t, homeLabel, externalHint } = Astro.props;
---

<footer class="footer">
  <div class="wrap footer__grid">
    <div class="footer__brand">
      <Wordmark legal label={homeLabel} />
      <p class="footer__tagline">{t.tagline}</p>
    </div>

    <div>
      <h2 class="footer__title">{t.productsTitle}</h2>
      <ul class="footer__list">
        {
          productList.map((product) => (
            <li>
              <a href={product.links[0]?.href} target="_blank" rel="noopener noreferrer">
                {product.name}
                <span class="footer__sub"> · {pick(product.tagline, locale)}</span>
                <span class="sr-only">{externalHint}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h2 class="footer__title">{t.legalTitle}</h2>
      <ul class="footer__list">
        {
          t.legal.map((item) => (
            <li>
              <a href={item.href} target="_blank" rel="noopener noreferrer">
                {item.label}
                <span class="sr-only">{externalHint}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="wrap footer__bottom">
    <p>© {siteConfig.year} {siteConfig.name}. {t.rights}</p>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    border-top: 1px solid var(--line-soft);
    background: linear-gradient(to bottom, transparent, rgb(20 24 41 / 0.7));
    padding-top: clamp(48px, 7vw, 88px);
  }

  .footer__grid {
    display: grid;
    gap: 40px;
    grid-template-columns: 1.4fr 1fr 1fr;
  }

  .footer__brand {
    display: grid;
    gap: 16px;
    align-content: start;
  }

  .footer__tagline {
    max-width: 32ch;
    color: var(--cyan);
    font-weight: 500;
  }

  .footer__title {
    margin-bottom: 14px;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  .footer__list {
    display: grid;
    gap: 4px;
  }

  .footer__list a {
    display: inline-block;
    padding-block: 11px;
    font-size: 0.9375rem;
    color: var(--text-2);
    transition: color 0.2s var(--ease);
  }

  .footer__list a:hover {
    color: var(--cyan);
  }

  .footer__sub {
    color: var(--text-3);
  }

  .footer__bottom {
    margin-top: clamp(36px, 5vw, 64px);
    padding-block: 24px;
    border-top: 1px solid var(--line-soft);
    font-size: 0.8125rem;
    color: var(--text-3);
  }

  @media (max-width: 860px) {
    .footer__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
