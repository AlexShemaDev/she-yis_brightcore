---
import { Image } from 'astro:assets';
import SectionHead from '../SectionHead.astro';
import Button from '../Button.astro';
import Icon from '../Icon.astro';
import { pick, type Dictionary, type Locale } from '../../i18n';
import type { Product } from '../../data/products';
import platform from '../../assets/products/neuremy/platform.webp';

interface Props {
  locale: Locale;
  n: number;
  t: Dictionary['neuremy'];
  product: Product;
  externalHint: string;
}

const { locale, n, t, product, externalHint } = Astro.props;
---

<section id="neuremy" class="section neuremy" data-section="neuremy" aria-labelledby="neuremy-title">
  <div class="wrap">
    <div class="neuremy__top">
      <div class="neuremy__copy">
        <SectionHead n={n} tag={t.tag} title={t.title} titleId="neuremy-title" lead={pick(product.description, locale)} />

        <ul class="neuremy__meta" data-reveal>
          <li class="status">
            <span class="status__dot" aria-hidden="true"></span>
            {pick(product.status, locale)}
          </li>
          <li class="neuremy__name">{product.name}</li>
        </ul>

        <div class="neuremy__cta" data-reveal>
          {
            product.links.map((link) => (
              <Button
                href={link.href}
                variant={link.kind}
                icon={link.icon}
                external
                externalHint={externalHint}
              >
                {pick(link.label, locale)}
              </Button>
            ))
          }
        </div>
      </div>

      <figure class="neuremy__media" data-parallax="-36">
        <div class="neuremy__glow" aria-hidden="true"></div>
        <Image
          src={platform}
          alt={t.imageAlt}
          width={1100}
          sizes="(max-width: 900px) 92vw, 560px"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>

    <div class="bus" data-bus>
      <h3 class="bus__title" data-reveal>{t.modulesTitle}</h3>
      <div class="bus__line" aria-hidden="true" data-bus-line></div>
      <ol class="bus__list">
        {
          product.features.map((feature, i) => (
            <li class="module" data-reveal-item data-bus-node style={`--o:${i % 2}`}>
              <span class="module__node" aria-hidden="true" />
              <span class="module__arm" aria-hidden="true" />
              <div class="module__card">
                <Icon name={feature.icon} size={28} class="module__icon" />
                <h4 class="module__title">{pick(feature.title, locale)}</h4>
                <p class="module__text">{pick(feature.text, locale)}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .neuremy__top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    align-items: center;
    gap: clamp(32px, 6vw, 80px);
  }

  .neuremy__copy {
    display: grid;
    gap: 28px;
    justify-items: start;
  }

  .neuremy__meta {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .neuremy__name {
    font-size: 0.8125rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border: 1px solid var(--line);
    border-radius: 99px;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--cyan);
  }

  .status__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--cyan);
    box-shadow: 0 0 8px var(--cyan);
  }

  .neuremy__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }

  .neuremy__media {
    position: relative;
    justify-self: center;
    width: 100%;
  }

  .neuremy__media :global(img) {
    position: relative;
    width: 100%;
    height: auto;
  }

  .neuremy__glow {
    position: absolute;
    inset: 12% 8% 4%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(0 191 255 / 0.22), transparent);
    filter: blur(24px);
  }

  /* ---- Module bus: six modules hang off a circuit line ---- */
  .bus {
    position: relative;
    margin-top: clamp(64px, 9vw, 112px);
    padding-top: 56px;
  }

  .bus__title {
    position: absolute;
    top: 0;
    left: 0;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  .bus__line {
    position: absolute;
    top: 80px;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--cyan);
    box-shadow: var(--glow-strong);
    transform-origin: left center;
    transform: scaleX(var(--p, 1));
    opacity: 0.85;
  }

  .bus__list {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 14px;
    padding-top: 0;
  }

  .module {
    position: relative;
    /* --o is 0 or 1: alternate modules hang lower, like steps on a circuit trace. */
    padding-top: calc(24px + var(--o) * 28px);
    margin-top: 24px;
  }

  .module__node {
    position: absolute;
    top: -6px;
    left: 20px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 2px solid var(--cyan);
    background: var(--bg);
    transition:
      background-color 0.3s var(--ease),
      box-shadow 0.3s var(--ease);
  }

  .module__arm {
    position: absolute;
    top: 6px;
    left: 25px;
    width: 2px;
    height: calc(18px + var(--o) * 28px);
    background: var(--line);
  }

  .module.is-lit .module__node {
    background: var(--cyan);
    box-shadow: var(--glow-strong);
  }

  .module__card {
    display: grid;
    gap: 10px;
    height: 100%;
    padding: 20px 18px 22px;
    border: 1.5px solid var(--line);
    border-radius: var(--radius-lg);
    background: rgb(26 31 58 / 0.78);
    transition:
      border-color 0.25s var(--ease),
      box-shadow 0.25s var(--ease),
      transform 0.25s var(--ease);
  }

  .module__card:hover {
    border-color: var(--cyan);
    box-shadow: var(--glow);
    transform: translateY(-3px);
  }

  .module :global(.module__icon) {
    color: var(--cyan);
  }

  .module__title {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .module__text {
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--text-2);
  }

  @media (max-width: 1080px) {
    .bus__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      row-gap: 28px;
    }

    .module:nth-child(n) {
      padding-top: 24px;
    }

    .module__arm {
      height: 18px;
    }

    .bus__line {
      display: none;
    }

    .module__node {
      left: 20px;
    }
  }

  @media (max-width: 900px) {
    .neuremy__top {
      grid-template-columns: 1fr;
    }

    .neuremy__media {
      order: 2;
      max-width: 40rem;
    }
  }

  @media (max-width: 640px) {
    .bus__list {
      grid-template-columns: 1fr;
      gap: 0;
      padding-left: 20px;
      border-left: 2px solid var(--line);
      margin-left: 6px;
    }

    .module {
      margin-top: 0;
      padding: 0 0 20px 24px;
    }

    .module__node {
      top: 22px;
      left: -27px;
    }

    .module__arm {
      top: 27px;
      left: -15px;
      width: 39px;
      height: 2px;
    }
  }
</style>
