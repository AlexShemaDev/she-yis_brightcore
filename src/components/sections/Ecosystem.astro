---
import SectionHead from '../SectionHead.astro';
import LogoMark from '../LogoMark.astro';
import type { Dictionary } from '../../i18n';

interface Props {
  n: number;
  t: Dictionary['ecosystem'];
  logoAlt: string;
}

const { n, t, logoAlt } = Astro.props;
---

<section
  id="ecosystem"
  class="section eco"
  data-section="ecosystem"
  data-eco
  aria-labelledby="ecosystem-title"
>
  <div class="wrap eco__grid">
    <div class="eco__copy">
      <SectionHead n={n} tag={t.tag} title={t.title} titleId="ecosystem-title" lead={t.lead} />

      <ol class="eco__steps">
        {
          t.steps.map((step, i) => (
            <li class="step" data-eco-step data-reveal-item data-step={i + 1}>
              <span class="step__n" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div class="step__body">
                <h3 class="step__verb">
                  <span class="sr-only">{t.stepLabel} {i + 1}: </span>
                  {step.verb}
                </h3>
                <p class="step__product">{step.product}</p>
                <p class="step__text">{step.text}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <ol class="eco__dots" aria-hidden="true">
        {t.steps.map((_, i) => <li data-eco-dot={i + 1} />)}
      </ol>
    </div>

    <div class="eco__mark" data-eco-mark>
      <LogoMark class="eco__logo" title={logoAlt} pulse />
    </div>
  </div>
</section>

<style>
  .eco__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    align-items: center;
    gap: clamp(32px, 6vw, 88px);
  }

  .eco__copy {
    display: grid;
    gap: 36px;
    justify-items: start;
  }

  .eco__steps {
    display: grid;
    gap: 28px;
    width: 100%;
  }

  .step {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 20px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }

  .step__n {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    color: var(--cyan);
    padding-top: 0.6rem;
    font-variant-numeric: tabular-nums;
  }

  .step__verb {
    font-size: clamp(1.75rem, 1.2rem + 2.4vw, 3rem);
    line-height: 1.1;
    font-weight: 700;
    letter-spacing: -0.5px;
    color: var(--text);
  }

  .step__product {
    margin-top: 6px;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--cyan);
  }

  .step__text {
    margin-top: 10px;
    max-width: 46ch;
    color: var(--text-2);
  }

  .eco__dots {
    display: none;
    gap: 10px;
  }

  .eco__dots li {
    width: 28px;
    height: 3px;
    border-radius: 3px;
    background: var(--line);
    transition: background-color 0.3s var(--ease);
  }

  .eco__dots li.is-on {
    background: var(--cyan);
  }

  .eco__mark {
    display: grid;
    place-items: center;
    justify-self: center;
    width: min(100%, 28.75rem);
  }

  .eco :global(.eco__logo) {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
  }

  /*
   * Pinned mode (class added by scripts/motion.ts on desktop with motion allowed):
   * the three steps stack in the same grid cell and cross-fade while the symbol is
   * drawn. Without it, steps are a plain readable list.
   */
  .eco.is-pinned {
    display: flex;
    align-items: center;
    min-height: calc(100svh - var(--header-h));
    padding-block: 32px;
  }

  .eco.is-pinned .wrap {
    width: 100%;
  }

  .eco.is-pinned .eco__steps {
    display: grid;
    gap: 0;
    min-height: 220px;
  }

  .eco.is-pinned .step {
    grid-area: 1 / 1;
    align-self: start;
  }

  .eco.is-pinned .eco__dots {
    display: flex;
  }

  @media (max-width: 860px) {
    .eco__grid {
      grid-template-columns: 1fr;
    }

    .eco__mark {
      order: -1;
      width: min(60vw, 16.25rem, 36svh);
      justify-self: start;
    }
  }
</style>
