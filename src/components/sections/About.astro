---
import SectionHead from '../SectionHead.astro';
import type { Dictionary } from '../../i18n';

interface Props {
  n: number;
  t: Dictionary['about'];
}

const { n, t } = Astro.props;

/** Seven lights in a constellation; the central, highest one is the shamash (manual p. 3). */
const lights = [
  { x: 6, y: 58 },
  { x: 20, y: 40 },
  { x: 34, y: 66 },
  { x: 48, y: 16 },
  { x: 62, y: 64 },
  { x: 76, y: 42 },
  { x: 90, y: 60 },
];
const SHAMASH = 3;
const path = lights.map((l, i) => `${i === 0 ? 'M' : 'L'}${l.x} ${l.y}`).join(' ');
---

<section id="about" class="section about" data-section="about" aria-labelledby="about-title">
  <div class="wrap about__grid">
    <div class="about__copy">
      <SectionHead n={n} tag={t.tag} title={t.title} titleId="about-title" />
      <p class="about__text lead" data-reveal>{t.text}</p>
    </div>

    <div class="about__side">
      <svg class="constellation" viewBox="0 0 100 100" aria-hidden="true" data-reveal>
        <path
          d={path}
          fill="none"
          stroke="currentColor"
          stroke-width="0.5"
          stroke-opacity="0.55"
          stroke-linecap="round"
          stroke-linejoin="round"
        ></path>
        {
          lights.map((light, i) => (
            <circle
              cx={light.x}
              cy={light.y}
              r={i === SHAMASH ? 2.6 : 1.6}
              fill="none"
              stroke="currentColor"
              stroke-width="0.7"
            />
          ))
        }
        <circle cx={lights[SHAMASH]?.x} cy={lights[SHAMASH]?.y} r="1" fill="currentColor"></circle>
      </svg>

      <h3 class="sr-only">{t.tonesLabel}</h3>
      <ul class="tones">
        {
          t.tones.map((tone, i) => (
            <li class="tone" data-reveal-item>
              <span class="tone__n" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div>
                <p class="tone__name">{tone.name}</p>
                <p class="tone__text">{tone.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: center;
  }

  .about__copy {
    display: grid;
    gap: 28px;
  }

  .about :global(.head__title) {
    max-width: 14ch;
    font-size: clamp(2.5rem, 1.4rem + 5vw, 5rem);
    line-height: 1.02;
    font-weight: 700;
  }

  .about__text {
    max-width: 56ch;
  }

  .about__side {
    display: grid;
    gap: 28px;
  }

  .constellation {
    width: 100%;
    height: auto;
    color: var(--cyan);
    overflow: visible;
  }

  .tones {
    display: grid;
  }

  .tone {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 20px;
    padding-block: 18px;
    border-top: 1px solid var(--line);
  }

  .tone:last-child {
    border-bottom: 1px solid var(--line);
  }

  .tone__n {
    padding-top: 0.25rem;
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    color: var(--cyan);
    font-variant-numeric: tabular-nums;
  }

  .tone__name {
    font-size: 1.25rem;
    font-weight: 600;
  }

  .tone__text {
    margin-top: 2px;
    color: var(--text-2);
  }

  @media (max-width: 860px) {
    .about__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
