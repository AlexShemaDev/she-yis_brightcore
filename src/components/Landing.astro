---
import BaseLayout from '../layouts/BaseLayout.astro';
import HexGrid from './HexGrid.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import CircuitRail from './CircuitRail.astro';
import CircuitDivider from './CircuitDivider.astro';
import Hero from './sections/Hero.astro';
import ProductNeuremy from './sections/ProductNeuremy.astro';
import ProductTopoQuizz from './sections/ProductTopoQuizz.astro';
import Ecosystem from './sections/Ecosystem.astro';
import Capabilities from './sections/Capabilities.astro';
import About from './sections/About.astro';
import Contact from './sections/Contact.astro';
import { sectionIds } from '../config/site';
import { productList, products } from '../data/products';
import { useTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<BaseLayout locale={locale} title={t.meta.title} description={t.meta.description}>
  <HexGrid />
  <a class="skip-link" href="#main">{t.a11y.skip}</a>
  <SiteHeader locale={locale} t={t.nav} homeLabel={t.a11y.homeLabel} />
  <CircuitRail ids={sectionIds} labels={t.rail.sections} label={t.rail.label} />

  <main id="main" data-landing>
    <Hero locale={locale} t={t.hero} logoAlt={t.a11y.logoAlt} products={productList} />
    <CircuitDivider />
    <ProductNeuremy locale={locale} n={2} t={t.neuremy} product={products.neuremy} externalHint={t.a11y.external} />
    <CircuitDivider flip />
    <ProductTopoQuizz locale={locale} n={3} t={t.topoquizz} product={products.topoquizz} externalHint={t.a11y.external} />
    <CircuitDivider />
    <Ecosystem n={4} t={t.ecosystem} logoAlt={t.a11y.logoAlt} />
    <CircuitDivider flip />
    <Capabilities n={5} t={t.capabilities} />
    <CircuitDivider />
    <About n={6} t={t.about} />
    <CircuitDivider flip />
    <Contact n={7} t={t.contact} />
  </main>

  <SiteFooter locale={locale} t={t.footer} homeLabel={t.a11y.homeLabel} externalHint={t.a11y.external} />
</BaseLayout>
